{
  "name": "tanks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "node scripts/prettier.js --write",
    "format:check": "node scripts/prettier.js --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites": "node --experimental-strip-types scripts/gen-sprites.ts",
    "sprites:check": "npm run sprites && git diff --exit-code -- public/sprites.png src/render/sprites.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "trystero": "0.26.0"
  }
}
